{
  "name": "prevail-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsdown && (tsdown --watch & node --env-file=.env --watch dist/main.js)",
    "build": "tsdown",
    "start": "node --env-file=.env dist/main.js",
    "check": "pnpm check",
    "fmt": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.12.23",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint-plugin-command": "^3.5.2",
    "eslint-plugin-import-boundaries": "^0.8.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.4.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.5.1"
