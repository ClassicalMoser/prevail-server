{
  "name": "prevail-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsdown && (tsdown --watch & node --env-file=.env --watch --watch-path=dist/main.js --watch-path=../prevail-rules/dist --watch-path=../prevail-contracts/dist dist/main.js)",
    "build": "tsdown",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "validate": "oxlint . && oxfmt . && tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@auth0/auth0-api-js": "^1.6.1",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@classicalmoser/prevail-contracts": "link:../prevail-contracts",
    "@classicalmoser/prevail-rules": "link:../prevail-rules",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.8.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.9",
    "classicalmoser-oxlint-config": "link:../../classicalmoser-oxlint-config",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import-boundaries": "^0.8.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-yml": "^3.8.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "ws": "^8.21.2"
  },
  "packageManager": "pnpm@11.5.1"
}
